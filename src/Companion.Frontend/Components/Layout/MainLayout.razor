@inherits LayoutComponentBase
@inject NavigationManager Navigation

<div class="flex min-h-dvh flex-col">
    <a href="@MainContentUrl" class="sr-only focus:not-sr-only focus:flex focus:min-h-11 focus:items-center focus:px-4">Skip to content</a>

    <header class="border-b border-border">
        <div class="mx-auto w-full max-w-3xl px-4">
            <a href="" class="inline-flex min-h-11 items-center font-semibold">Universal Companion</a>
        </div>
    </header>

    <main id="main" tabindex="-1" class="mx-auto w-full max-w-3xl flex-1 px-4 py-6">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    // <base href="/"> would send a bare #main link to the home page.
    private string MainContentUrl => $"{Navigation.Uri.Split('#')[0]}#main";
}
