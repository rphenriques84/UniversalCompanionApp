{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Game",
  "description": "data/games/<game>/game.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["key", "name"],
  "properties": {
    "$schema": { "type": "string" },
    "key": {
      "description": "Permanent. Must match the folder name.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": { "type": "string", "minLength": 1 }
  }
}
