# Copy to .env and set your own local values. Never commit .env.
ASPNETCORE_ENVIRONMENT=Development

# Service token keys. Generate them with: dotnet tools/generate-service-keys.cs >> .env
# SERVICE_TOKEN_PRIVATE_KEY=
# SERVICE_TOKEN_PUBLIC_KEY=

# Only during key rotation: the old public key, so tokens signed with the old key stay valid.
# SERVICE_TOKEN_PREVIOUS_PUBLIC_KEY=
