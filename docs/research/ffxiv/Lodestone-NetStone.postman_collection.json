  "item": [
    {
      "name": "Character",
      "item": [
        {
          "name": "Search character",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "User-Agent",
                "value": "{{userAgent}}",
                "description": "NetStone / lodestone-css-selectors parse the mobile layout"
              },
              {
                "key": "Accept",
                "value": "text/html"
              }
            ],
            "url": {
              "raw": "{{lodestone}}/character/?q={{characterName}}&worldname={{world}}",
              "host": [
                "{{lodestone}}"
              ],
              "path": [
                "character"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "{{characterName}}",
                  "description": "Name"
                },
                {
                  "key": "worldname",
                  "value": "{{world}}",
                  "description": "World"
                },
                {
                  "key": "page",
                  "value": "{{page}}",
                  "description": "",
                  "disabled": true
                }
              ]
            },
            "description": "NetStone: SearchCharacter(CharacterSearchQuery)"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Is HTML', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/html'));"
                ]
              }
            }
          ]
        },
