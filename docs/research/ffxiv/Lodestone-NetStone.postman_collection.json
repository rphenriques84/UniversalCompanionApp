{
  "info": {
    "_postman_id": "1b4925af-4edd-4e5d-b7fd-b373d3f4a96f",
    "name": "Lodestone (NetStone targets)",
    "description": "NetStone is a .NET library, not an HTTP API. These are the Lodestone pages it scrapes, returning HTML.\nUse them to inspect markup when a parser breaks, or to compare with lodestone-css-selectors.\n\nBe gentle: ~1 req/s. No official API or rate limit; SE may throttle/block.\nIn code, call NetStone (e.g. client.GetCharacter(id)) instead.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "lodestone",
      "value": "https://na.finalfantasyxiv.com/lodestone"
    },
    {
      "key": "userAgent",
      "value": "Mozilla/5.0 (iPhone; CPU iPhone OS 17_0 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.0 Mobile/15E148 Safari/604.1"
    },
